{
  "tasks": {
    "install": "deno install --frozen",
    "content:fetch": "deno run --allow-read=content --allow-env=CONTENT_REPO,CONTENT_TOKEN,CONTENT_REF --allow-run=git tools/cli/fetch-content.ts",
    "content:check": "deno run --allow-read=content --allow-env=ALLOW_EXAMPLE_CONTENT tools/cli/check-content.ts",
    "fonts": "deno run --allow-read --allow-write=generated tools/cli/build-fonts.ts",
    "themes": "deno run --allow-read --allow-write=generated,.cache --allow-net=raw.githubusercontent.com tools/cli/build-themes.ts",
    "licenses": "deno run --allow-read --allow-write=generated,.cache --allow-net=raw.githubusercontent.com tools/cli/build-licenses.ts",
    "prepare": "deno task install && deno task fonts && deno task themes && deno task licenses",
    "dev": "deno task content:fetch && deno task prepare && hugo server --renderToMemory",
    "build": "deno task content:fetch && deno task content:check && deno task prepare && hugo build --minify --cleanDestinationDir",
    "build:fixtures": "deno task prepare && hugo build --minify --cleanDestinationDir --config hugo.toml,tests/fixtures/hugo.toml --destination generated/fixture-site",
    "lint": "biome ci . && taplo fmt --check && taplo lint && actionlint && deno task conventions && deno task deps && deno task duplication",
    "conventions": "deno run --allow-run=git --allow-read tools/cli/check-conventions.ts",
    "deps": "deno run --allow-read --allow-env --allow-sys npm:dependency-cruiser/depcruise --config .dependency-cruiser.json tools tests assets/ts",
    "deps:metrics": "deno run --allow-read --allow-env --allow-sys npm:dependency-cruiser/depcruise --config .dependency-cruiser.json --output-type metrics tools",
    "deps:graph": "deno run --allow-read --allow-env --allow-sys npm:dependency-cruiser/depcruise --config .dependency-cruiser.json --output-type mermaid tools",
    "duplication": "deno run --allow-read --allow-env --allow-sys --allow-run npm:jscpd --config .jscpd.json",
    "format": "biome check --write . && taplo fmt",
    "secrets": "gitleaks git --redact --no-banner",
    "audit": "deno audit",
    "typecheck": "deno check tools tests assets/ts",
    "test": "deno test --allow-read --allow-write tests/unit",
    "coverage": "deno test --allow-read --allow-write --coverage=.cache/coverage --clean tests/unit && deno coverage .cache/coverage --lcov --output=.cache/coverage.lcov --exclude=tests/",
    "validate:html": "deno run --allow-read --allow-env --allow-sys npm:html-validate 'generated/fixture-site/**/*.html'",
    "test:e2e": "deno task build:fixtures && deno task validate:html && deno test --allow-read --allow-write --allow-net --allow-env --allow-run tests/e2e tests/specs",
    "specs": "deno task build:fixtures && deno test --allow-read --allow-write --allow-net --allow-env --allow-run tests/specs",
    "risk": "deno run --allow-run=git --allow-env --allow-write tools/cli/risk-report.ts",
    "ci": "deno task lint && deno task secrets && deno task audit && deno task typecheck && deno task test && deno task test:e2e",
    "hooks": "lefthook install"
  },
  "imports": {
    "@astral/astral": "jsr:@astral/astral@0.5.6",
    "@cucumber/gherkin": "npm:@cucumber/gherkin@42.0.1",
    "@cucumber/messages": "npm:@cucumber/messages@34.2.1",
    "@fontsource/fira-code": "npm:@fontsource/fira-code@5.3.0",
    "@fontsource/fira-sans": "npm:@fontsource/fira-sans@5.3.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/http": "jsr:@std/http@1.1.4",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/toml": "jsr:@std/toml@1.0.11",
    "@valibot/valibot": "jsr:@valibot/valibot@1.5.0",
    "@webtui/css": "npm:@webtui/css@0.1.10",
    "axe-core": "npm:axe-core@4.14.0",
    "dependency-cruiser": "npm:dependency-cruiser@18.5.0",
    "html-validate": "npm:html-validate@11.16.2",
    "jscpd": "npm:jscpd@5.4.0",
    "typescript": "npm:typescript@5.9.3"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  }
}
