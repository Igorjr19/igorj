# Cloudflare Pages response headers. The scripts and styles of the app carry a content hash in their names, so they
# never change under the same address; fonts, icons, pictures and the original images do not, so they get a week.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/share/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
