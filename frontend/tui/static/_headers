# Cloudflare Pages response headers. Scripts, styles and share images carry a content hash in their names,
# so they never change under the same address; fonts, icons and the original images do not, so they get a week.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/ts/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/share/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
