{{- /* What the terminal reads, in the page language: the same model the pages show, as plain text. */ -}}
{{- $model := partial "model.html" . }}
{{- $entry := dict }}
{{- $items := dict }}
{{- range $section := slice "posts" "projects" "research" }}
{{- $list := slice }}
{{- range index $model $section }}
{{- $item := . }}
{{- with partial "item-page.html" (dict "section" $section "item" .) }}
{{- $facts := "" }}
{{- if eq $section "posts" }}{{ $facts = printf "%s · %s" $item.category.name $item.date }}
{{- else if eq $section "projects" }}{{ $facts = delimit $item.stack ", " }}
{{- else }}{{ $facts = printf "%s · %d · %s" (i18n (printf "research%s" (title $item.kind))) (int $item.year) $item.venue }}{{ end }}
{{- $list = $list | append (dict "name" (printf "%s.md" $item.id) "title" $item.title "facts" $facts "summary" ($item.summary | default "") "url" .RelPermalink "text" .Plain) }}
{{- end }}
{{- end }}
{{- $items = merge $items (dict $section $list) }}
{{- end }}
{{- $panes := slice }}
{{- range $i, $pane := partial "window/panes.html" . }}{{ $panes = $panes | append (dict "key" $pane.key "label" (i18n $pane.label) "url" $pane.page.RelPermalink) }}{{ end }}
{{- $themes := slice }}
{{- with hugo.Data.generated.themes }}{{ range .families }}{{ $family := .name }}{{ range .themes }}{{ $themes = $themes | append (dict "id" .id "name" .name "family" $family) }}{{ end }}{{ end }}{{ end }}
{{- $accents := slice }}
{{- with hugo.Data.generated.themes.accents }}{{ range .options }}{{ $accents = $accents | append .name }}{{ end }}{{ end }}
{{- $strings := dict }}
{{- range slice "termWelcome" "termNotFound" "termNotDir" "termNeedFile" "termUnknown" "termOpening" "termThemeSet" "termThemeUnknown" "termAccents" "termNoManual" "termHelpLs" "termHelpCd" "termHelpCat" "termHelpOpen" "termHelpTree" "termHelpFetch" "termHelpTheme" "termHelpMan" "termHelpRest" "termRole" "termLocation" "termContent" "termListening" "termWatched" "termThemeLabel" "termBuild" "termShell" "termShellValue" "termKeys" "termName" "termSynopsis" "termDescription" "termNow" "termSeeAlso" "termContact" "termPlays" "nowWork" "nowMasters" "nowStudying" "modeTerminal" }}
{{- $strings = merge $strings (dict . (i18n .)) }}
{{- end }}
{{- $strings = merge $strings (dict "contentSummary" (printf "%s · %s · %s" (i18n "countPosts" (len $model.posts)) (i18n "countProjects" (len $model.projects)) (i18n "countResearch" (len $model.research)))) }}
{{- $commit := substr (hugo.Data.generated.build.commit | default "") 0 7 }}
{{- jsonify (dict
  "profile" $model.profile
  "contact" $model.contact
  "items" $items
  "music" ($model.music | default dict)
  "films" ($model.films | default dict)
  "reading" ($model.reading | default slice)
  "panes" $panes
  "themes" $themes
  "accents" $accents
  "build" (dict "commit" $commit "date" (now.Format "2006-01-02"))
  "host" (urls.Parse site.BaseURL).Host
  "strings" $strings
) }}
